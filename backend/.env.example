# ---------------------------------------------------------------------------
# BTP-2027 backend configuration. Copy to `.env` and edit. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- database -------------------------------------------------------------
# Relative paths are resolved against the backend/ directory.
DATABASE_URL=sqlite:///./data/btp.db

# --- camera / vision feed -------------------------------------------------
# Only used by scripts/yolo_bridge.py, which drives the UPSTREAM pipeline.
# The API itself never opens a camera.
#   0                       webcam
#   ../video/site.mp4       video file
#   rtsp://user:pass@host/1 RTSP camera
VIDEO_SOURCE=0
CAMERA_ID=camera_01

# Pixel space the upstream pipeline produces boxes in. Construction_Safety_BTP
# resizes every frame to 640x480 before inference, so leave these unless you
# change that.
FRAME_WIDTH=640
FRAME_HEIGHT=480

# --- spatial --------------------------------------------------------------
HOMOGRAPHY_FILE=data/calibration/homography.json
SITE_PLAN_FILE=data/site_map/site_plan.json

# Site extent in metres. Drives the dashboard map layout.
SITE_WIDTH_M=30
SITE_DEPTH_M=20

# --- telemetry ------------------------------------------------------------
# Minimum seconds between two stored positions for the SAME worker.
TELEMETRY_SAMPLE_INTERVAL=0.5
TELEMETRY_RETENTION_HOURS=72

# --- alerting -------------------------------------------------------------
ALERT_COOLDOWN_SECONDS=30
PPE_VIOLATION_MIN_SECONDS=2
ALERT_AUTO_RESOLVE_SECONDS=10

# PPE that is mandatory on this site. Items outside this list are still shown
# on the dashboard but never raise an alert.
# Available: helmet, vest, mask
REQUIRED_PPE=helmet,vest

# --- presence policy ------------------------------------------------------
# A gap between sightings longer than this is NOT counted as time on site.
PRESENCE_GAP_SECONDS=15
# No sighting for this long flips the worker to OFF_SITE.
ABSENT_AFTER_SECONDS=60

# --- demo -----------------------------------------------------------------
DEMO_MODE=false
DEMO_FPS=8

# --- websocket ------------------------------------------------------------
# Upper bound only. The real rate follows the upstream pipeline.
BROADCAST_MAX_FPS=15

# --- CORS -----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
